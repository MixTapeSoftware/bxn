# boxen.macos.setup
# macOS pre-flight: ensures Colima + Incus are installed and running.
# Sourced by boxen.create — inherits colors, log/warn/error, and set -euo pipefail.

# ---------------------------------------------------------------------------
# Skip on Linux
# ---------------------------------------------------------------------------
if [[ "$(uname -s)" != "Darwin" ]]; then
  return 0 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# Defaults (override by setting these vars before sourcing)
# ---------------------------------------------------------------------------
COLIMA_CPUS="${COLIMA_CPUS:-4}"
COLIMA_MEMORY="${COLIMA_MEMORY:-8}"
COLIMA_DISK="${COLIMA_DISK:-100}"
COLIMA_PROFILE="${COLIMA_PROFILE:-boxen}"

# Colima mounts your home directory into its VM, writable, unless told
# otherwise. Instances never use it (a workspace is a copy, not a mount), and
# a way out of a container would land next to it. So bxn starts its profile
# with --mount none, which Colima saves with the profile: a start without
# --mount keeps it. Colima reads `none` that way from 0.10.0; an older one
# would take it for a folder, so it gets no flag and a warning instead.
# True when the installed Colima is 0.10.0 or later.
colima_takes_mount_none() {
  local v major rest minor
  v="$(colima version 2>/dev/null | awk 'NR == 1 && $2 == "version" { print $3 }')" || true
  v="${v#v}"
  major="${v%%.*}"
  rest="${v#*.}"
  minor="${rest%%.*}"
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 1
  ((10#$major > 0 || 10#$minor >= 10))
}

# ---------------------------------------------------------------------------
# A dry run installs, creates and starts nothing: it says what the real run
# would do first, and stops there, since everything after needs Incus.
# ---------------------------------------------------------------------------
# The profile's status (Running, Stopped), or empty when there's no such
# profile. Its name is matched exactly: boxen2 is not boxen. A colima list
# that fails reads as no profile, as it did before, so the next step (creating
# it) runs and colima says what is wrong, instead of set -e ending the run
# here without a word.
colima_profile_status() {
  command -v colima >/dev/null 2>&1 || return 0
  colima list 2>/dev/null | awk -v p="$COLIMA_PROFILE" '$1 == p { print $2; exit }' || true
}

if [[ "${DRY_RUN:-0}" == "1" ]]; then
  _would=()
  command -v colima >/dev/null 2>&1 || _would+=("install Colima (brew install colima)")
  command -v incus >/dev/null 2>&1 || _would+=("install the Incus CLI (brew install incus)")
  _status="$(colima_profile_status)"
  _mounts="your home directory mounted (Colima 0.10.0 or later can leave it out)"
  colima_takes_mount_none && _mounts="no folders from this Mac mounted"
  if [[ -z "$_status" ]]; then
    _would+=("create the Colima profile '${COLIMA_PROFILE}': ${COLIMA_CPUS} CPUs, ${COLIMA_MEMORY}GB memory, ${COLIMA_DISK}GB disk, $_mounts")
  elif [[ "$_status" != Running ]]; then
    _would+=("start the Colima profile '${COLIMA_PROFILE}', with $_mounts")
  fi
  if [[ ${#_would[@]} -gt 0 ]]; then
    echo "DRY RUN — nothing will be created"
    for _w in "${_would[@]}"; do echo "  The real run would first $_w"; done
    echo "  The rest needs Incus running, so the dry run stops here."
    exit 0
  fi
  unset _would _status _mounts
fi

# ---------------------------------------------------------------------------
# Check Colima
# ---------------------------------------------------------------------------
if ! command -v colima >/dev/null 2>&1; then
  echo ""
  warn "Colima is required to run Incus on macOS."
  read -rp "Install Colima via brew? [Y/n] " reply
  if [[ "${reply:-Y}" =~ ^[Nn]$ ]]; then
    error "Colima is required on macOS. Install it with: brew install colima"
  fi
  log "Installing Colima..."
  brew install colima
fi

# ---------------------------------------------------------------------------
# Check Incus CLI
# ---------------------------------------------------------------------------
if ! command -v incus >/dev/null 2>&1; then
  echo ""
  warn "Incus CLI is required."
  read -rp "Install Incus via brew? [Y/n] " reply
  if [[ "${reply:-Y}" =~ ^[Nn]$ ]]; then
    error "Incus CLI is required. Install it with: brew install incus"
  fi
  log "Installing Incus CLI..."
  brew install incus
fi

# ---------------------------------------------------------------------------
# Check Colima profile
# ---------------------------------------------------------------------------
PROFILE_EXISTS=0
PROFILE_RUNNING=0

_status="$(colima_profile_status)"
if [[ -n "$_status" ]]; then
  PROFILE_EXISTS=1
  if [[ "$_status" == Running ]]; then
    PROFILE_RUNNING=1
  fi
fi
unset _status

COLIMA_NO_MOUNTS=()
if [[ "$PROFILE_RUNNING" == "0" ]]; then
  if colima_takes_mount_none; then
    COLIMA_NO_MOUNTS=(--mount none)
  else
    warn "This Colima can't start without mounting your home directory into its VM (that takes Colima 0.10.0 or later). A way out of a container would reach it. Upgrade with: brew upgrade colima"
  fi
fi

if [[ "$PROFILE_EXISTS" == "0" ]]; then
  log "Creating Colima profile '${COLIMA_PROFILE}' with Incus runtime..."
  log "Resources: ${COLIMA_CPUS} CPUs, ${COLIMA_MEMORY}GB memory, ${COLIMA_DISK}GB disk${COLIMA_NO_MOUNTS[0]:+, no folders from this Mac mounted}"
  colima start --runtime incus --profile "$COLIMA_PROFILE" \
    --cpu "$COLIMA_CPUS" --memory "$COLIMA_MEMORY" --disk "$COLIMA_DISK" ${COLIMA_NO_MOUNTS[@]+"${COLIMA_NO_MOUNTS[@]}"}

elif [[ "$PROFILE_RUNNING" == "0" ]]; then
  # A profile made by an earlier bxn may mount the home directory: this
  # start removes the mount, for good.
  log "Starting Colima profile '${COLIMA_PROFILE}'${COLIMA_NO_MOUNTS[0]:+, with no folders from this Mac mounted}..."
  colima start --profile "$COLIMA_PROFILE" ${COLIMA_NO_MOUNTS[@]+"${COLIMA_NO_MOUNTS[@]}"}

else
  log "Colima profile '${COLIMA_PROFILE}' is running."
  # Stopping it would stop every instance, so a running profile is only
  # checked. Mounts show as virtiofs, 9p or sshfs in the VM.
  _mounts="$(colima ssh --profile "$COLIMA_PROFILE" -- findmnt -rn -o TARGET -t virtiofs,9p,fuse.sshfs 2>/dev/null </dev/null | tr '\n' ' ' | LC_ALL=C tr -cd '[:print:]' || true)"
  if [[ -n "${_mounts// /}" ]]; then
    _fix="colima stop -p ${COLIMA_PROFILE} && colima start -p ${COLIMA_PROFILE} --mount none"
    colima_takes_mount_none || _fix="brew upgrade colima, then $_fix"
    warn "Colima profile '${COLIMA_PROFILE}' mounts folders from this Mac (${_mounts% }). A way out of a container would reach them. bxn doesn't use them; to remove them, when nothing is running: $_fix"
  fi
  unset _mounts _fix
fi

# ---------------------------------------------------------------------------
# Verify Incus connectivity
# ---------------------------------------------------------------------------
if ! incus list >/dev/null 2>&1; then
  error "Incus CLI cannot connect. Check 'incus remote list' and ensure a local remote is configured."
fi

log "Incus is ready."
