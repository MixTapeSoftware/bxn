#!/bin/bash
set -euo pipefail

# install-incus-scripts
# Creates symbolic links to incus helper scripts in ~/.local/bin

# Colors for output
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log()   { echo -e "${GREEN}[+]${NC} $1"; }
warn()  { echo -e "${YELLOW}[!]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; exit 1; }

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Chadmux host tmux config, and the bxn skill for the host's coding agents:
# ask (interactive only), yes, or no.
CHADMUX="ask"
BXN_SKILL="ask"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --chadmux)      CHADMUX="yes"; shift ;;
    --no-chadmux)   CHADMUX="no"; shift ;;
    --bxn-skill)    BXN_SKILL="yes"; shift ;;
    --no-bxn-skill) BXN_SKILL="no"; shift ;;
    -h|--help)
      echo "Usage: $(basename "$0") [--chadmux|--no-chadmux] [--bxn-skill|--no-bxn-skill]"
      echo "  --chadmux       Install the Chadmux tmux config on this host without asking"
      echo "  --no-chadmux    Skip the Chadmux question"
      echo "  --bxn-skill     Install the bxn skill for Claude Code and Codex on this host without asking"
      echo "  --no-bxn-skill  Skip the bxn skill question"
      exit 0
      ;;
    *) error "Unknown option: $1" ;;
  esac
done

# Files to link
FILES=(
  "bxn"
  "boxen.shell"
  "boxen.create"
  "boxen.network"
  "boxen.macos.setup"
  "bxn.new-plugin"
)

# Short aliases: alias_name:target_file
ALIAS_NAMES=("bxnc" "bxnn")
ALIAS_TARGETS=("boxen.create" "boxen.network")

# Ensure ~/.local/bin exists
mkdir -p ~/.local/bin

log "Installing incus helper scripts to ~/.local/bin"

for file in "${FILES[@]}"; do
  SOURCE="$SCRIPT_DIR/$file"
  TARGET="$HOME/.local/bin/$file"

  # Check if source file exists
  if [[ ! -f "$SOURCE" ]]; then
    warn "Source file not found: $SOURCE (skipping)"
    continue
  fi

  # Make source file executable
  chmod +x "$SOURCE"

  # Remove existing symlink or file if it exists
  if [[ -L "$TARGET" ]]; then
    log "Removing existing symlink: $TARGET"
    rm "$TARGET"
  elif [[ -f "$TARGET" ]]; then
    warn "File exists (not a symlink): $TARGET"
    read -p "Overwrite? [y/N] " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
      rm "$TARGET"
    else
      warn "Skipping $file"
      continue
    fi
  fi

  # Create symlink
  ln -s "$SOURCE" "$TARGET"
  log "Linked: $file -> $TARGET"
done

# boxen.create was boxen.init, and bxnc was bxni: don't leave the old links
# pointing at nothing.
for old_link in "$HOME/.local/bin/boxen.init" "$HOME/.local/bin/bxni"; do
  if [[ -L "$old_link" && ! -e "$old_link" ]]; then
    rm "$old_link"
    log "Removed the old link: $old_link"
  fi
done

# Create short alias symlinks
for i in "${!ALIAS_NAMES[@]}"; do
  alias_name="${ALIAS_NAMES[$i]}"
  TARGET_FILE="${ALIAS_TARGETS[$i]}"
  ALIAS_TARGET="$HOME/.local/bin/$alias_name"
  LINK_DEST="$SCRIPT_DIR/$TARGET_FILE"

  if [[ ! -f "$LINK_DEST" ]]; then
    warn "Alias target not found: $LINK_DEST (skipping $alias_name)"
    continue
  fi

  if [[ -L "$ALIAS_TARGET" ]]; then
    rm "$ALIAS_TARGET"
  elif [[ -f "$ALIAS_TARGET" ]]; then
    warn "File exists (not a symlink): $ALIAS_TARGET"
    read -p "Overwrite? [y/N] " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
      rm "$ALIAS_TARGET"
    else
      warn "Skipping alias $alias_name"
      continue
    fi
  fi

  ln -s "$LINK_DEST" "$ALIAS_TARGET"
  log "Alias: $alias_name -> $TARGET_FILE"
done

# Optional: Chadmux on the host. Off unless chosen; an existing host tmux
# config is always left alone.
CHADMUX_STATE="$("$SCRIPT_DIR/chadmux.host" status)"
case "$CHADMUX_STATE" in
  installed)
    log "Chadmux is already installed on this host"
    ;;
  existing\ *)
    [[ "$CHADMUX" != "no" ]] && \
      log "Keeping your tmux config at ${CHADMUX_STATE#existing } (Chadmux not installed)"
    ;;
  missing\ *)
    [[ "$CHADMUX" != "no" ]] && \
      warn "Chadmux needs ${CHADMUX_STATE#missing } on this host; skipping"
    ;;
  incomplete)
    # Chadmux was chosen before but TPM is missing; finishing touches only ~/.tmux/plugins.
    if [[ "$CHADMUX" != "no" ]]; then
      warn "Chadmux config is installed, but TPM is missing"
      if [[ "$CHADMUX" == "ask" && -t 0 ]]; then
        read -rp "Finish Chadmux setup by installing TPM? [Y/n] " reply || reply=""
        [[ ! "$reply" =~ ^[Nn]$ ]] && CHADMUX="yes"
      fi
      if [[ "$CHADMUX" == "yes" ]]; then
        "$SCRIPT_DIR/chadmux.host" install || warn "TPM setup failed; re-run ./install_shortcuts --chadmux to retry"
      else
        warn "Re-run ./install_shortcuts --chadmux to finish TPM setup"
      fi
    fi
    ;;
  absent)
    if [[ "$CHADMUX" == "ask" && -t 0 ]]; then
      echo ""
      echo "Chadmux is Chad's tmux config. It labels each pane with the Incus"
      echo "instance it is shelled into, for one pane per container on the host."
      read -rp "Install Chadmux tmux config on this host? [y/N] " reply || reply=""
      [[ "$reply" =~ ^[Yy]$ ]] && CHADMUX="yes"
    fi
    if [[ "$CHADMUX" == "yes" ]]; then
      "$SCRIPT_DIR/chadmux.host" install || warn "Chadmux install failed; your scripts are still installed"
    fi
    ;;
esac

# Optional: the bxn skill, a plugin for Claude Code and Codex from this
# repository's marketplace, so an agent on this host knows how to drive bxn.
# Off unless chosen, and only offered to the agents installed here that don't
# have it yet. Both CLIs' install commands are safe to rerun.
BXN_SKILL_MARKETPLACE="MixTapeSoftware/bxn"

# The host's agents without the skill, space separated.
bxn_skill_missing() {
  local missing=""
  if command -v claude >/dev/null 2>&1 &&
    ! grep -qF '"bxn@bxn"' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json" 2>/dev/null; then
    missing="claude"
  fi
  if command -v codex >/dev/null 2>&1 &&
    ! codex plugin list </dev/null 2>/dev/null | grep -Eq '^bxn@bxn[[:space:]]+installed'; then
    missing="${missing:+$missing }codex"
  fi
  echo "$missing"
}

# Installs it for each agent named. One that fails doesn't stop the other.
bxn_skill_install() {
  local agent failed=""
  for agent in $1; do
    if [[ "$agent" == claude ]]; then
      claude plugin install bxn --marketplace "$BXN_SKILL_MARKETPLACE" </dev/null || failed="${failed:+$failed }claude"
    else
      { codex plugin marketplace add "$BXN_SKILL_MARKETPLACE" && codex plugin add bxn@bxn; } </dev/null ||
        failed="${failed:+$failed }codex"
    fi
  done
  if [[ -n "$failed" ]]; then
    warn "The bxn skill didn't install for: $failed. Re-run ./install_shortcuts --bxn-skill to retry"
    return 1
  fi
  log "Installed the bxn skill for: $1"
}

if [[ "$BXN_SKILL" != "no" ]]; then
  SKILL_AGENTS="$(bxn_skill_missing)"
  if [[ -n "$SKILL_AGENTS" ]]; then
    if [[ "$BXN_SKILL" == "ask" && -t 0 ]]; then
      echo ""
      echo "The bxn skill teaches coding agents on this host how to use bxn: creating"
      echo "boxes, opening hosts on their allowlists, serving ports, and what can reach what."
      read -rp "Install it for $SKILL_AGENTS (a plugin from github.com/$BXN_SKILL_MARKETPLACE)? [y/N] " reply || reply=""
      [[ "$reply" =~ ^[Yy]$ ]] && BXN_SKILL="yes"
    elif [[ "$BXN_SKILL" == "ask" ]]; then
      log "To install the bxn skill for $SKILL_AGENTS: ./install_shortcuts --bxn-skill"
    fi
    if [[ "$BXN_SKILL" == "yes" ]]; then
      bxn_skill_install "$SKILL_AGENTS" || true
    fi
  elif [[ "$BXN_SKILL" == "yes" ]]; then
    if command -v claude >/dev/null 2>&1 || command -v codex >/dev/null 2>&1; then
      log "The bxn skill is already installed for this host's agents"
    else
      warn "The bxn skill is for Claude Code or Codex, and this host has neither"
    fi
  fi
fi

echo ""
log "Done! Make sure ~/.local/bin is in your PATH"

# Check if ~/.local/bin is in PATH
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  warn "~/.local/bin is not in your PATH"
  echo ""
  echo "Add this to your ~/.bashrc or ~/.zshrc:"
  echo '  export PATH="$HOME/.local/bin:$PATH"'
fi
